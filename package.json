{
  "name": "n8n-nodes-bulkit",
  "version": "0.2.0",
  "description": "Bulkit for n8n: schedule and publish social media posts to X, LinkedIn, Instagram, Facebook, Threads, TikTok, YouTube, Pinterest, Reddit, Bluesky and Vimeo from your n8n workflows.",
  "license": "MIT",
  "author": {
    "name": "Bulkit",
    "email": "contact@bulkit.io",
    "url": "https://bulkit.io"
  },
  "homepage": "https://bulkit.io",
  "bugs": {
    "url": "https://github.com/bulkit-io/n8n-nodes-bulkit/issues",
    "email": "contact@bulkit.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bulkit-io/n8n-nodes-bulkit.git"
  },
  "keywords": [
    "n8n-community-node-package",
    "bulkit",
    "n8n",
    "n8n-node",
    "n8n-nodes",
    "n8n-integration",
    "n8n-workflow",
    "automation",
    "workflow-automation",
    "social-media",
    "social-media-automation",
    "social-media-scheduler",
    "social-media-api",
    "scheduling",
    "post-scheduler",
    "auto-post",
    "cross-post",
    "twitter",
    "x",
    "linkedin",
    "instagram",
    "facebook",
    "threads",
    "tiktok",
    "youtube",
    "pinterest",
    "reddit",
    "bluesky",
    "vimeo"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.js",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepublishOnly": "pnpm lint && pnpm build"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/BulkitApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Bulkit/Bulkit.node.js",
      "dist/nodes/BulkitTrigger/BulkitTrigger.node.js"
    ]
  },
  "packageManager": "pnpm@11.8.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@n8n/node-cli": "0.54.6",
    "eslint": "9.32.0",
    "n8n-workflow": "^2.16.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
